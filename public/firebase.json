{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "server.mjs",
      "package.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "database": "ai-studio-webvaultestudio-3664e681-6cb2-4d10-b68f-167b898e1692"
  }
}